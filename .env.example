# Copiá este archivo a ".env" y completá tus valores.
# El .env está en .gitignore: NUNCA se sube a git.

# --- Instagram (Graph API) ---
IG_USER_ID=tu_instagram_business_user_id
IG_ACCESS_TOKEN=tu_token_de_larga_duracion

# --- (Opcional) URL pública base donde sirvas /output para Instagram ---
PUBLIC_BASE_URL=https://tu-dominio-o-tunel.example.com

# --- Footage royalty-free para fondos del canal faceless ---
# Pixabay (recomendado, key inmediata): https://pixabay.com/api/docs/
PIXABAY_API_KEY=tu_api_key_de_pixabay
# Pexels (alternativa, a veces pausa keys nuevas): https://www.pexels.com/api/
PEXELS_API_KEY=tu_api_key_de_pexels

# --- Pipeline de Reddit ("¿Soy el Malo?") ---
# App de Reddit tipo "script": https://www.reddit.com/prefs/apps  (gratis)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=soyelmalo/0.1 by u/tu_usuario
# LLM para reescritura (Groq gratis por default): https://console.groq.com/keys
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
